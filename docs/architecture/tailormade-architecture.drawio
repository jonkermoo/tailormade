<mxfile host="app.diagrams.net"><diagram id="tailormade-arch" name="Architecture"><mxGraphModel dx="1640" dy="1120" grid="1" gridSize="10" guides="1" page="1" pageWidth="1640" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;TailorMade on Azure: a timed pipeline finds and scores jobs; one web app serves users&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#4B5563;font-size:13px&#x27;&gt;Numbers 1–7 follow a new posting from source to the user&amp;#x27;s screen. Dashed arrows are CI/CD.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1200" height="56" as="geometry"/></mxCell><mxCell id="azure" value="Microsoft Azure  ·  resource group rg-tailormade" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15;fontColor=#0078D4;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="1110" height="840" as="geometry"/></mxCell><mxCell id="lane" value="Ingestion pipeline  ·  Worker Function App (Python, Flex Consumption)" style="rounded=1;arcSize=4;fillColor=none;strokeColor=#6B7280;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=13;fontColor=#4B5563;html=1;" vertex="1" parent="1"><mxGeometry x="280" y="115" width="970" height="175" as="geometry"/></mxCell><mxCell id="swa" value="Azure Static Web Apps (Free)  ·  built-in sign-in" style="rounded=1;arcSize=5;fillColor=#F3F8FD;strokeColor=#0078D4;verticalAlign=bottom;align=left;spacingLeft=14;fontStyle=1;fontSize=13;fontColor=#1F2937;html=1;" vertex="1" parent="1"><mxGeometry x="280" y="560" width="560" height="180" as="geometry"/></mxCell><mxCell id="shared" value="Shared services (used by API and worker)" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#6B7280;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=13;